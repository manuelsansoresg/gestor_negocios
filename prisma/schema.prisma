generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMINISTRADOR
}

enum LeadStatus {
  NUEVO
  CONTACTADO
  INTERESADO
  SEGUIMIENTO
  CITA_AGENDADA
  NO_INTERESADO
  CERRADO
  SPAM
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(ADMINISTRADOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Lead {
  id        Int        @id @default(autoincrement())
  fullName  String
  phone     String
  email     String
  message   String     @db.Text
  status    LeadStatus @default(NUEVO)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}
